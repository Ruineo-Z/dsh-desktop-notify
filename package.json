{
  "name": "dsh-desktop-notify",
  "version": "0.1.0",
  "description": "DSH 桌面通知：agent 执行完成 / 失败 / 中断 / 需要批准时，发送 macOS 原生桌面通知，无需一直盯着 Web GUI。",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "desktop-notify"
  ],
  "license": "MIT"
}
